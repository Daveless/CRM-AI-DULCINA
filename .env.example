# Copiar a .env.functions.local (o pasar con --env-file a `supabase functions serve`).
# Nunca commitear un archivo con valores reales.

# Meta Cloud API (número de prueba durante el desarrollo, sección 8.6 del manual)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=

# LLM orquestador (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Sincronización de catálogo (WooCommerce → products, Edge Function catalog-sync)
WOOCOMMERCE_SITE_URL=
WOOCOMERCE_CONSUMIDOR=
WOOCOMERCE_SECRET=

# Inyectados automáticamente por `supabase functions serve` / al desplegar;
# solo hace falta definirlos manualmente si se ejecuta fuera de la CLI.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
